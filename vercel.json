{
  "rewrites": [
    {
      "source": "/l/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|skypeuripreview|pinterest|applebot|googlebot|bingbot).*"
        }
      ],
      "destination": "https://dizai-backend-production.up.railway.app/public/previa/l/:slug"
    },
    {
      "source": "/l/:slug/agenda",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|skypeuripreview|pinterest|applebot|googlebot|bingbot).*"
        }
      ],
      "destination": "https://dizai-backend-production.up.railway.app/public/previa/l/:slug/agenda"
    },
    {
      "source": "/l/:slug/foto/:fotoId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|skypeuripreview|pinterest|applebot|googlebot|bingbot).*"
        }
      ],
      "destination": "https://dizai-backend-production.up.railway.app/public/previa/l/:slug/foto/:fotoId"
    },
    {
      "source": "/public/previa/imagem/:caminho*",
      "destination": "https://dizai-backend-production.up.railway.app/public/previa/imagem/:caminho*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
